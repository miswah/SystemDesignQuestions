      "updated": 1779274446201,
      "link": null,
      "locked": false,
      "text": "Redirection 301 vs 302\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redirection 301 vs 302\n",
