    },
    {
      "id": "f-DA5_q93LP2T-RKEb9VI",
      "type": "text",
      "x": 1032.335025649376,
      "y": 2432.564399293611,
      "width": 701.37939453125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 496440746,
      "version": 305,
      "versionNonce": 185495594,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779043689289,
      "link": null,
      "locked": false,
      "text": "Avoid overhead by using direct lenght-specific pathways. It treats \ninputs as a single integer, combines them with the key/seed, and passes\nthem through custom multiplers and avalance mixing stages",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avoid overhead by using direct lenght-specific pathways. It treats \ninputs as a single integer, combines them with the key/seed, and passes\nthem through custom multiplers and avalance mixing stages",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9QbaFmd4OLZaOeaRDQ35I",
      "type": "text",
      "x": 1033.9060978118628,
      "y": 2518.973368230372,
      "width": 666.2794189453125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
      "roundness": null,
      "seed": 512886762,
      "version": 382,
      "versionNonce": 1641909674,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779043223756,
      "link": null,
      "locked": false,
      "text": "SIMD Acceleration -> vector instructions (ARM NENO, AVX-512 etc)\n\nAvalance effect -> a series of bitwise shifts and multiplications to\nensure that changing even a single bit in the input causes seemingly \nrandom completely different output -> no hash collision to deal with",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SIMD Acceleration -> vector instructions (ARM NENO, AVX-512 etc)\n\nAvalance effect -> a series of bitwise shifts and multiplications to\nensure that changing even a single bit in the input causes seemingly \nrandom completely different output -> no hash collision to deal with",
      "autoResize": true,
      "lineHeight": 1.25
    },
