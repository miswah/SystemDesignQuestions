    {
      "id": "T-DyToeGNx4GR7hxO8Kyj",
      "type": "text",
      "x": 1036.662362707274,
      "y": 2043.6913260761155,
      "width": 681.7996215820312,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
