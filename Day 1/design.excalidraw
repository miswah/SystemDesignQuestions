    {
      "id": "XC1B7FEINWGTmNQpo7gaK",
      "type": "text",
      "x": 947.0900900410745,
      "y": 1054.1883676389134,
      "width": 716.2993774414062,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
