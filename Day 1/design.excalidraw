      "seed": 209381686,
      "version": 298,
      "versionNonce": 893656070,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779120685217,
      "link": null,
      "locked": false,
      "text": "Assumming the service will run for 10 years\n    100m * 12 * 10 = 12000m requets\n\nAssuming average URL length = 100 bytes (short + long)\n    Storage req over 10 years =  12000m * 100 bytes = 1.2 TB in lifetime",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumming the service will run for 10 years\n    100m * 12 * 10 = 12000m requets\n\nAssuming average URL length = 100 bytes (short + long)\n    Storage req over 10 years =  12000m * 100 bytes = 1.2 TB in lifetime",
      "autoResize": true,
      "lineHeight": 1.25
    },
