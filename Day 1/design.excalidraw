    },
    {
      "id": "HG_4Wk2ZgZ7c5SmAe-TeP",
      "type": "text",
      "x": 89.2539829886191,
      "y": 2067.8239428456545,
      "width": 927.7390747070312,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 148640234,
      "version": 537,
      "versionNonce": 985322282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779043223756,
      "link": null,
      "locked": false,
      "text": "If Priority is to reduce the server loda using 301 redirect makes sense as only the first\nrequest of the same URL is sent to servers.\n\nIf analytics is important 302 redirect is better choice as it can track click rate and other\nsources of the click more easily.\n\nAs we need the analytics we will be using 302 to have browser hit our servers on each request\nto capture all the details mentioned in the requirements",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If Priority is to reduce the server loda using 301 redirect makes sense as only the first\nrequest of the same URL is sent to servers.\n\nIf analytics is important 302 redirect is better choice as it can track click rate and other\nsources of the click more easily.\n\nAs we need the analytics we will be using 302 to have browser hit our servers on each request\nto capture all the details mentioned in the requirements",
      "autoResize": true,
      "lineHeight": 1.25
    },
