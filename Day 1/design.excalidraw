    {
      "id": "22CFPFfgjYw7Fkx73UN2W",
      "type": "text",
      "x": -130.1447531920362,
      "y": 947.4105887503589,
      "width": 440.8796081542969,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 598344694,
      "version": 363,
      "versionNonce": 488555738,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779120690196,
      "link": null,
      "locked": false,
      "text": "1. Accept a long url as input\n    Generate an uniqiue short url\n\n2. When user access a short URL redirect to\n    the original long URL\n\n3. Track Click countm Location, device type\n\n4. Provide API for programmatic creation\nand management of URLs",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Accept a long url as input\n    Generate an uniqiue short url\n\n2. When user access a short URL redirect to\n    the original long URL\n\n3. Track Click countm Location, device type\n\n4. Provide API for programmatic creation\nand management of URLs",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "209eXwyrpSvFTO7PmAafS",
      "type": "text",
      "x": 351.52191347463054,
      "y": 935.7439220836923,
      "width": 443.6595764160156,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1066690998,
      "version": 384,
      "versionNonce": 1499797914,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779120690196,
      "link": null,
      "locked": false,
      "text": "1. Redirection should happen quickly \n        50-100 ms\n\n2. Should be avaaible at least 99.99%\n\n3. Must support millions to billion of requests\n\n4. System is read heavy \n    (100:1 read/write ration)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Redirection should happen quickly \n        50-100 ms\n\n2. Should be avaaible at least 99.99%\n\n3. Must support millions to billion of requests\n\n4. System is read heavy \n    (100:1 read/write ration)",
      "autoResize": true,
      "lineHeight": 1.25
    },
