      "seed": 320947386,
      "version": 132,
      "versionNonce": 73899450,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786382910644,
      "link": null,
      "locked": false,
      "text": "How does MyGate know that I ordered something on Swiggy even \nwhen I never gave Swiggy permission to access MyGate?\n\nThat's the problem statment this design document aim to solve.\n\nThe system should be able to detect or infer that a delivery is expected \nat a particular apartment, villa, or household inside a gated community and \nnotify the relevant resident in advance.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How does MyGate know that I ordered something on Swiggy even \nwhen I never gave Swiggy permission to access MyGate?\n\nThat's the problem statment this design document aim to solve.\n\nThe system should be able to detect or infer that a delivery is expected \nat a particular apartment, villa, or household inside a gated community and \nnotify the relevant resident in advance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
