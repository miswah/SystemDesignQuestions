      "link": null,
      "locked": false,
      "text": "Address Matching",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Address Matching",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rb-rd32UEGx2dnxyqEnxH",
      "type": "text",
      "x": 1035.670634920636,
      "y": 1318.837301587302,
      "width": 993.6790771484375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 1989887206,
      "version": 176,
      "versionNonce": 1244064550,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786384041558,
      "link": null,
      "locked": false,
      "text": "We have several ways of matching the address even though the address might be messy or in another\nformat",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We have several ways of matching the address even though the address might be messy or in another\nformat",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "H1-4ih6nT8HkCaIOZcW3B",
      "type": "text",
      "x": 1038.527777777779,
      "y": 1387.4087301587306,
      "width": 1007.2591552734375,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 942011514,
      "version": 1027,
      "versionNonce": 611759654,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786384498763,
      "link": null,
      "locked": false,
      "text": "Option 1 :  Address Mapping\nMyGate and the delivery apps both maintain a standard list/address of societies this help us with\nmatching the address 1:1, The con of this appraoch is that onboarding any new delivery app requires\nthem to also maintain the list \n\nOption 2 :  Phone Number\nwe use the phone number to match the account on both the services, the con of this appraoch is that\nthe user might order from a number that's not present in either of the system basically stoppping\nthis feature from doing anything\n\noption 3 : Address Normalization\n we don't compare raw address instead we normalize the raw string into a standard address format\nwe have a pipleline of these operations\n\nRaw Address > Cleaning > Tokenization > Entity Extraction > Standardize > matching > score\n\nThe output of this pipeline would the standard address object",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Option 1 :  Address Mapping\nMyGate and the delivery apps both maintain a standard list/address of societies this help us with\nmatching the address 1:1, The con of this appraoch is that onboarding any new delivery app requires\nthem to also maintain the list \n\nOption 2 :  Phone Number\nwe use the phone number to match the account on both the services, the con of this appraoch is that\nthe user might order from a number that's not present in either of the system basically stoppping\nthis feature from doing anything\n\noption 3 : Address Normalization\n we don't compare raw address instead we normalize the raw string into a standard address format\nwe have a pipleline of these operations\n\nRaw Address > Cleaning > Tokenization > Entity Extraction > Standardize > matching > score\n\nThe output of this pipeline would the standard address object",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w3TxTwtmDFecIcSA6VOIf",
      "type": "rectangle",
      "x": 2085.3552767505994,
      "y": 1320.3398535959884,
      "width": 1378.3333333333335,
      "height": 487.0868739465385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
