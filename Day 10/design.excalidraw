          "type": "arrow"
        }
      ],
      "updated": 1786385357240,
      "link": null,
      "locked": false,
      "text": "Map<String, String> aliases = Map.of(\n    \"apt\", \"flat\",\n    \"apartment\", \"flat\",\n    \"fl\", \"flat\",\n    \"unit\", \"flat\",\n\n    \"rd\", \"road\",\n    \"st\", \"street\",\n\n    \"no\", \"number\"\n);",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Map<String, String> aliases = Map.of(\n    \"apt\", \"flat\",\n    \"apartment\", \"flat\",\n    \"fl\", \"flat\",\n    \"unit\", \"flat\",\n\n    \"rd\", \"road\",\n    \"st\", \"street\",\n\n    \"no\", \"number\"\n);",
      "autoResize": true,
      "lineHeight": 1.25
    },
