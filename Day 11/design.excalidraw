    },
    {
      "id": "FqM-7crLBBkyCJXanD7XJ",
      "type": "text",
      "x": 735.7834843359146,
      "y": 992.9977822134331,
      "width": 600.3994140625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 964253581,
      "version": 294,
      "versionNonce": 1471048557,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786988399573,
      "link": null,
      "locked": false,
      "text": "1. Span Ingestion Latency < 100ms\n2. Trace Search Latency < 1s\n3. SDK Overhead < 10ms/req\n4. memory overhead < 100mb/service\n5. Retention 7-30 days\n6. Encryption TLS + Encryption at Rest\n7. Fault Tolerance : no business impact if tracing system fails",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Span Ingestion Latency < 100ms\n2. Trace Search Latency < 1s\n3. SDK Overhead < 10ms/req\n4. memory overhead < 100mb/service\n5. Retention 7-30 days\n6. Encryption TLS + Encryption at Rest\n7. Fault Tolerance : no business impact if tracing system fails",
      "autoResize": true,
      "lineHeight": 1.25
    },
