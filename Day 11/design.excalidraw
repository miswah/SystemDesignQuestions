      "text": "{\n  \"serviceName\": \"order-service\",\n  \"strategy\": \"TAIL\",\n  \"rules\": [\n    {\n      \"condition\": \"status == ERROR\",\n      \"sampleRate\": 1.0\n    },\n    {\n      \"condition\": \"durationMs > 1000\",\n      \"sampleRate\": 0.5\n    }\n  ]\n}",
