    {
      "id": "nZpBWKbb8W5AnXdCC1xaK",
      "type": "text",
      "x": 2223.8794596158305,
      "y": 2341.685803981558,
      "width": 498.6595458984375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
