      "index": "b0X",
      "roundness": null,
      "seed": 747130595,
      "version": 312,
      "versionNonce": 94029613,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786992305460,
      "link": null,
      "locked": false,
      "text": "we will use mongodb here because of these reasons\n    * high wirte throughput\n    * append-only workloads\n\n\nOR we can use Elasticsearch/BigQuery etc but\nthe cost will be higher and vendor locking will be an\nissue\n  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we will use mongodb here because of these reasons\n    * high wirte throughput\n    * append-only workloads\n\n\nOR we can use Elasticsearch/BigQuery etc but\nthe cost will be higher and vendor locking will be an\nissue\n  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
