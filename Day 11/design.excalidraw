      "locked": false,
      "text": "2. Trace Collector Service\n* Receives spans from sdk\n* validate & enrich spans\n* applu sampling decisions\n* forward spans to processing pipeline",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Trace Collector Service\n* Receives spans from sdk\n* validate & enrich spans\n* applu sampling decisions\n* forward spans to processing pipeline",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wqr5A9mjMHgiuhFSuWr6j",
      "type": "text",
      "x": 2861.278010349857,
      "y": 2404.2293856177002,
      "width": 579.826416015625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
