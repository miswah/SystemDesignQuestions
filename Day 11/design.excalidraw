    {
      "id": "heoa-swcwKjuJ9MBzAWAC",
      "type": "text",
      "x": 722,
      "y": 147,
      "width": 627.2194213867188,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 181376525,
      "version": 830,
      "versionNonce": 495378989,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786988217982,
      "link": null,
      "locked": false,
      "text": "1. Trace Management \n      * unique Trace id for each request\n      * unique Span id for each service operations\n      * Support Distributed context propagation across services\n      * Trace should reconstrcut complete request execution\n\n2. Span Collection\n    * Capture I/O requests\n    * Capture DB operations\n    * Support asynchronous messaging systems\n\n3. Search & Query\n    * Search by Trace Id, Service Name, Time Range, Error Code\n        latency, tags and attributes\n\n4. Visualization\n    * Trace timeline view\n    * Waterfall view\n    * Service Depedency Graph\n    * Critical Path Analysis\n    * Error Highlighting\n\n5. Monitoring & Alerting\n    * Latency Threshold Alerts\n    * Error Rate Alerts\n    * Collector Health Monitoring\n    * Span Drop Monitoring\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Trace Management \n      * unique Trace id for each request\n      * unique Span id for each service operations\n      * Support Distributed context propagation across services\n      * Trace should reconstrcut complete request execution\n\n2. Span Collection\n    * Capture I/O requests\n    * Capture DB operations\n    * Support asynchronous messaging systems\n\n3. Search & Query\n    * Search by Trace Id, Service Name, Time Range, Error Code\n        latency, tags and attributes\n\n4. Visualization\n    * Trace timeline view\n    * Waterfall view\n    * Service Depedency Graph\n    * Critical Path Analysis\n    * Error Highlighting\n\n5. Monitoring & Alerting\n    * Latency Threshold Alerts\n    * Error Rate Alerts\n    * Collector Health Monitoring\n    * Span Drop Monitoring\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
