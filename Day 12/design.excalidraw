      "seed": 652565899,
      "version": 200,
      "versionNonce": 725782507,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787589124526,
      "link": null,
      "locked": false,
      "text": "Redis runs all commands in a single thread, so there is no risk of\ntwo commands interfering partway through. there is a builtin\ncommand to claim a key and it supprots TTL",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis runs all commands in a single thread, so there is no risk of\ntwo commands interfering partway through. there is a builtin\ncommand to claim a key and it supprots TTL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
