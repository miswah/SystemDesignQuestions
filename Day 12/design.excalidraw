      "index": "b0E",
      "roundness": null,
      "seed": 984208998,
      "version": 154,
      "versionNonce": 181380966,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788194403811,
      "link": null,
      "locked": false,
      "text": "2. Get Lock Owner\nGET /api/v1/admin/locks/{lockKey}/ownership\n\nResponse Body :-\n{\n  \"lockKey\": \"order:123\",\n  \"locked\": true,\n  \"ownerId\": \"payment-service-instance-42\",\n  \"lockId\": \"8f2c7c3e-5d91-4b2c-a9d2\",\n  \"fencingToken\": 1042,\n  \"expiresAt\": \"2026-08-27T17:31:00Z\"\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Get Lock Owner\nGET /api/v1/admin/locks/{lockKey}/ownership\n\nResponse Body :-\n{\n  \"lockKey\": \"order:123\",\n  \"locked\": true,\n  \"ownerId\": \"payment-service-instance-42\",\n  \"lockId\": \"8f2c7c3e-5d91-4b2c-a9d2\",\n  \"fencingToken\": 1042,\n  \"expiresAt\": \"2026-08-27T17:31:00Z\"\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fFJfm1UEgLCBBl2XLor9R",
      "type": "text",
      "x": 2234.9780010980653,
      "y": 873.9122111835879,
      "width": 447.07958984375,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
