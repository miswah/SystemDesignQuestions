    {
      "id": "uCVfszRDTf6SKXubv3fFA",
      "type": "text",
      "x": 2234.326805677205,
      "y": 180.25268414112907,
      "width": 495.91949462890625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
