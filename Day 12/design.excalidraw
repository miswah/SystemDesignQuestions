      "boundElements": [],
      "updated": 1787589178489,
      "link": null,
      "locked": false,
      "text": " NX option in the SET command means “set the key only if it does \n                            not already exist.” ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " NX option in the SET command means “set the key only if it does \n                            not already exist.” ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
