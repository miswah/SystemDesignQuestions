      "isDeleted": false,
      "boundElements": null,
      "updated": 1788194132418,
      "link": null,
      "locked": false,
      "text": "1. Force Unlock\n\nPOST /api/v1/admin/locks/{lockKey}/force-release\n\nRequest Body :-\n\n{\n  \"reason\": \"Owner instance permanently crashed\"\n}\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Force Unlock\n\nPOST /api/v1/admin/locks/{lockKey}/force-release\n\nRequest Body :-\n\n{\n  \"reason\": \"Owner instance permanently crashed\"\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cLp1xS9sRocsgj7f6Rgqm",
      "type": "text",
      "x": 2233.172977620097,
      "y": 510.86402931271573,
      "width": 449.93951416015625,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
