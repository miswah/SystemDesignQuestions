      "isDeleted": false,
      "boundElements": null,
      "updated": 1787589178489,
      "link": null,
      "locked": false,
      "text": " NX option in the SET command means “set the key only if it does \n                            not already exist.” ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " NX option in the SET command means “set the key only if it does \n                            not already exist.” ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cO1KzbutqExQeaHHRF9-u",
      "type": "text",
      "x": 187.88888888888883,
      "y": 794.6666666666666,
      "width": 459.81951904296875,
      "height": 25,
      "angle": 0,
