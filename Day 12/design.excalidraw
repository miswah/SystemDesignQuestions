    },
    {
      "id": "Lr1JeN2SplExrLxe42LSe",
      "type": "text",
      "x": 200.11111111111111,
      "y": 862.4444444444443,
      "width": 623.8394775390625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1050534053,
      "version": 191,
      "versionNonce": 1674403301,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787589263501,
      "link": null,
      "locked": false,
      "text": "Redis reply with \"OK\" to this operation and the user is consider\nthe owner of the lock untill TTL. nil or an empty response\nmeans another client already owns it.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis reply with \"OK\" to this operation and the user is consider\nthe owner of the lock untill TTL. nil or an empty response\nmeans another client already owns it.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q7mEUZHLDOQ2do1qnd1rG",
      "type": "text",
      "x": 196.7777777777778,
      "y": 968,
      "width": 572.7994384765625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
