      "isDeleted": false,
      "boundElements": [],
      "updated": 1787589388557,
      "link": null,
      "locked": false,
      "text": "You can extend the lock using : PEXPIRE lockKey newTTL\n\nonce finsihes client is supposed to delete the key with\nDEL lockKey",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You can extend the lock using : PEXPIRE lockKey newTTL\n\nonce finsihes client is supposed to delete the key with\nDEL lockKey",
      "autoResize": true,
      "lineHeight": 1.25
    },
