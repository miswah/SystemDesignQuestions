      "isDeleted": false,
      "boundElements": null,
      "updated": 1787589668527,
      "link": null,
      "locked": false,
      "text": "ZooKeeper",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ZooKeeper",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XW8Kc3SjYFkIx_Pxukz4U",
      "type": "text",
      "x": 884.1984126984128,
      "y": 594.9444444444446,
      "width": 664.8194580078125,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 569529195,
      "version": 1082,
      "versionNonce": 2019278917,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787592511411,
      "link": null,
      "locked": false,
      "text": "Runs as a cluster of nodes that keep data consistent across\na majority of them. any lock record is replicated so evey node\nin the cluster knows about it. This consistency helps avoid\nconfusion if one node is temporarily out of synce.\n\nwe create somehting like /locks/lockKey in ZooKeeper if ther is no\nrecord you can successfully claim the lock. if the lock exists\nwe wait or fail\n\nwhen the process is done we delete the ephemeral node or lease key\nnode is removed if you just disconnect or explciit cleanup is allow\n\nthe client watches the lock path if the lock holder crashes, Zook\ndetect the session loss and removes the node instantly notifying\nwatchers that the lock is free again.\n\nuse zookeeper if it's already there in the setup they provide\nstrong consistency guarantees at cost of heavier operational\noverhead compared to Redis.\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Runs as a cluster of nodes that keep data consistent across\na majority of them. any lock record is replicated so evey node\nin the cluster knows about it. This consistency helps avoid\nconfusion if one node is temporarily out of synce.\n\nwe create somehting like /locks/lockKey in ZooKeeper if ther is no\nrecord you can successfully claim the lock. if the lock exists\nwe wait or fail\n\nwhen the process is done we delete the ephemeral node or lease key\nnode is removed if you just disconnect or explciit cleanup is allow\n\nthe client watches the lock path if the lock holder crashes, Zook\ndetect the session loss and removes the node instantly notifying\nwatchers that the lock is free again.\n\nuse zookeeper if it's already there in the setup they provide\nstrong consistency guarantees at cost of heavier operational\noverhead compared to Redis.\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
