    {
      "id": "A2iT9ItCwXXRaQW7CFqGe",
      "type": "text",
      "x": 1138.4680549037193,
      "y": 1159.4401796318205,
      "width": 129.21987915039062,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
