      "link": null,
      "locked": false,
      "text": "2. Release Lock\n\nDELETE /api/v1/locks/{lockKey}\n\nRequest Body\n\n{\n  \"lockId\": \"8f2c7c3e-5d91-4b2c-a9d2-123456789abc\",\n  \"ownerId\": \"payment-service-instance-42\"\n}\n\nwith ownership so not anyone can realease the lock\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Release Lock\n\nDELETE /api/v1/locks/{lockKey}\n\nRequest Body\n\n{\n  \"lockId\": \"8f2c7c3e-5d91-4b2c-a9d2-123456789abc\",\n  \"ownerId\": \"payment-service-instance-42\"\n}\n\nwith ownership so not anyone can realease the lock\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
