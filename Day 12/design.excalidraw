    {
      "id": "6gHXETNLLkz0jq1QGrcWY",
      "type": "text",
      "x": 193.13095238095246,
      "y": 2411.638888888889,
      "width": 663.6993408203125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 301097803,
      "version": 255,
      "versionNonce": 1650706955,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787592217998,
      "link": null,
      "locked": false,
      "text": "Locks are session bound they are freed if the session is terminated\ncons of it is that lock might remain locked if your sesison hangs\naround in a weird state\n\nthese  will need a map to map the integer to process or name",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Locks are session bound they are freed if the session is terminated\ncons of it is that lock might remain locked if your sesison hangs\naround in a weird state\n\nthese  will need a map to map the integer to process or name",
      "autoResize": true,
      "lineHeight": 1.25
    },
