    {
      "id": "fdmeM_lSekXtuU2GgbFCx",
      "type": "text",
      "x": 196.14682539682553,
      "y": 1635.174603174603,
      "width": 604.0394287109375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
