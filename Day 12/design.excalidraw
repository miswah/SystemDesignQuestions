      "type": "text",
      "x": 191.70238095238108,
      "y": 1364.063492063492,
      "width": 626.4193725585938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 1781872005,
      "version": 259,
      "versionNonce": 1414838341,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787591637770,
      "link": null,
      "locked": false,
      "text": "PostgreSQL, MySQL etc provides built-in locking features that \ncan help you coordinate concurrency directly in your existing env\nThere are two ways to handle locks in a relation database :\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PostgreSQL, MySQL etc provides built-in locking features that \ncan help you coordinate concurrency directly in your existing env\nThere are two ways to handle locks in a relation database :\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FPg-vK9xdBBzIyevJ3QZo",
      "type": "text",
      "x": 237.25793650793662,
      "y": 1455.1746031746031,
      "width": 514.5794677734375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 216760933,
      "version": 16,
      "versionNonce": 1665682539,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787591648946,
      "link": null,
      "locked": false,
      "text": "row-level locks (like SELECT ... FOR UPDATE)\n\nadvisory locks (like pg_advisory_lock or GET_LOCK)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "row-level locks (like SELECT ... FOR UPDATE)\n\nadvisory locks (like pg_advisory_lock or GET_LOCK)",
      "autoResize": true,
      "lineHeight": 1.25
    },
