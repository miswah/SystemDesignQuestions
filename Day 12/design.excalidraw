    {
      "id": "qGiwKdo1kCPJiz_NyovSE",
      "type": "text",
      "x": 189.00000000000003,
      "y": 588,
      "width": 631.0794677734375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
