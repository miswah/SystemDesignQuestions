      "link": null,
      "locked": false,
      "text": "There is an option to use RedLock algorithm as well in case of\nnetwork partitions which coordinates across multiple Redis\ninstancees to reduce the chance of conflicting lock ownership",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There is an option to use RedLock algorithm as well in case of\nnetwork partitions which coordinates across multiple Redis\ninstancees to reduce the chance of conflicting lock ownership",
      "autoResize": true,
      "lineHeight": 1.25
    },
