    {
      "id": "Fh2zJ0lIjwxxQlpQOkh4n",
      "type": "text",
      "x": 217,
      "y": 230,
      "width": 578.8795776367188,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
