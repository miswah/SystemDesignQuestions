      "roundness": null,
      "seed": 1047434277,
      "version": 135,
      "versionNonce": 1643979877,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787591849423,
      "link": null,
      "locked": false,
      "text": "we can leverage built-in locking feature to manage concurrency\nmany database provide two main methods :\n\n1. ROW-Level Locks\n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we can leverage built-in locking feature to manage concurrency\nmany database provide two main methods :\n\n1. ROW-Level Locks\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cqc0UvvAFOFv-GGGEEloZ",
      "type": "text",
      "x": 192.81349206349216,
      "y": 1748.5079365079364,
      "width": 645.0594482421875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 1304114251,
      "version": 60,
      "versionNonce": 1372965291,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787591867403,
      "link": null,
      "locked": false,
      "text": "BEGIN;\nSELECT * FROM locks WHERE lock_id = @loc_key FOR UPDATE;\n/* make changes */\nCOMMIT;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BEGIN;\nSELECT * FROM locks WHERE lock_id = @loc_key FOR UPDATE;\n/* make changes */\nCOMMIT;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_pXXHHtbAb_4weSXZhDYA",
      "type": "text",
      "x": 197.25793650793673,
      "y": 1867.3968253968253,
      "width": 642.5394287109375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 514431723,
      "version": 296,
      "versionNonce": 1921963077,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787591939049,
      "link": null,
      "locked": false,
      "text": "we wrap the sql command with the transaction query include\nFOR UPDATE which tells db to lock this row so nobody else can\nmodify it until i am done. If someone else try to update the same\nrow they'll have to wait.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we wrap the sql command with the transaction query include\nFOR UPDATE which tells db to lock this row so nobody else can\nmodify it until i am done. If someone else try to update the same\nrow they'll have to wait.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dRXaF-S5-ccnlQe6JWCYz",
      "type": "text",
      "x": 200.59126984126993,
      "y": 1999.6190476190475,
      "width": 428.61962890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 2025867013,
      "version": 50,
      "versionNonce": 1133731941,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787591960817,
      "link": null,
      "locked": false,
      "text": "The lock last untill COMMIT or ROLLBACK ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The lock last untill COMMIT or ROLLBACK ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pJTeU2w92pMseqCrLX3kr",
      "type": "text",
      "x": 195.3531746031747,
      "y": 2054.9722222222226,
      "width": 572.1395263671875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1948043237,
      "version": 130,
      "versionNonce": 386347845,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787592064685,
      "link": null,
      "locked": false,
      "text": "2. Advisory Locks (pg_advisory_lock)\n    instead of trying a lock to specific row we can lock an \n    arbitarty identifier:\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Advisory Locks (pg_advisory_lock)\n    instead of trying a lock to specific row we can lock an \n    arbitarty identifier:\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
