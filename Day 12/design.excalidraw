      "seed": 1165912058,
      "version": 186,
      "versionNonce": 816442938,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788194417885,
      "link": null,
      "locked": false,
      "text": "3. List All active locks\n\nGET /api/v1/admin/locks\n\nResponse Body\n\n{\n  \"locks\": [\n    {\n      \"lockKey\": \"order:123\",\n      \"ownerId\": \"payment-service-instance-42\",\n      \"fencingToken\": 1042,\n      \"expiresAt\": \"2026-08-27T17:31:00Z\"\n    },\n    {\n      \"lockKey\": \"order:456\",\n      \"ownerId\": \"order-service-instance-7\",\n      \"fencingToken\": 1043,\n      \"expiresAt\": \"2026-08-27T17:31:12Z\"\n    }\n  ]\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
