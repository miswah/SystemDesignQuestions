    {
      "id": "Fh2zJ0lIjwxxQlpQOkh4n",
      "type": "text",
      "x": 217,
      "y": 230,
      "width": 578.8795776367188,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1076110693,
      "version": 469,
      "versionNonce": 2107329803,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787589013879,
      "link": null,
      "locked": false,
      "text": "1. Redis - we store a lock key with TTL once the task is \n    done we remove the key\n\n2. ZooKeeper - write a record occuring the lock if you go\n    offline system removes your record automatically this\n    apporach offers strong consistency guarantees\n\n3. Database Locks - use the same db with a new table\n    put a named lock on the table and remove it afterwards\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Redis - we store a lock key with TTL once the task is \n    done we remove the key\n\n2. ZooKeeper - write a record occuring the lock if you go\n    offline system removes your record automatically this\n    apporach offers strong consistency guarantees\n\n3. Database Locks - use the same db with a new table\n    put a named lock on the table and remove it afterwards\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
