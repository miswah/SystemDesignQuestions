      "index": "aZ",
      "roundness": null,
      "seed": 1903613803,
      "version": 41,
      "versionNonce": 1257935147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787592074348,
      "link": null,
      "locked": false,
      "text": "SELECT pg_advisory_lock(12345);",
