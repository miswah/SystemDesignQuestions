      "seed": 1354950475,
      "version": 15,
      "versionNonce": 489797643,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787593034682,
      "link": null,
      "locked": false,
      "text": "Redlock redis",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redlock redis",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Lwz9QRiFvFDq0Z7q_POZd",
      "type": "text",
      "x": 908.2409144970281,
      "y": 1223.5043373363278,
      "width": 670.2794189453125,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1139110219,
      "version": 975,
      "versionNonce": 256438859,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787593399085,
      "link": null,
      "locked": false,
      "text": "In redis data replication is performed by the background process\nnot the master thread, so it makes it eventual consistent even\nunder the strict settings\n\nwe can't use a simple lock command in case of multiple redis partition\nso redis introduced an algorithm called RedLock\n\nsince redis is not reliable we form a commitee of multiple Redis. if \nand only if more than half of the committee members agree, the lock\nwill take effect; otherwise the lock is invalid. The members can be\nsingle master-slave or even clusters, but nevertheless they are\nindepedendent of each other -> no duplicates\n\nwe use Majority consensus algorithm\n\n\nThe network delay and packet loss still makes the communication\nchaotic and complicated adding to the time lock is held for\n\nMany additional instance of redis node is need to make it reliable",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In redis data replication is performed by the background process\nnot the master thread, so it makes it eventual consistent even\nunder the strict settings\n\nwe can't use a simple lock command in case of multiple redis partition\nso redis introduced an algorithm called RedLock\n\nsince redis is not reliable we form a commitee of multiple Redis. if \nand only if more than half of the committee members agree, the lock\nwill take effect; otherwise the lock is invalid. The members can be\nsingle master-slave or even clusters, but nevertheless they are\nindepedendent of each other -> no duplicates\n\nwe use Majority consensus algorithm\n\n\nThe network delay and packet loss still makes the communication\nchaotic and complicated adding to the time lock is held for\n\nMany additional instance of redis node is need to make it reliable",
      "autoResize": true,
      "lineHeight": 1.25
    },
