    {
      "id": "Bvju1uJ0G4LazaqDUymkL",
      "type": "text",
      "x": 1090.388888888889,
      "y": 533.0992063492064,
      "width": 103.29989624023438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
