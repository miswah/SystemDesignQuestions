      "seed": 1941483066,
      "version": 48,
      "versionNonce": 1804476666,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788193712463,
      "link": null,
      "locked": false,
      "text": "1. Acquire Lock \n\nPOST /api/v1/locks/{lockKey}/acquire\n\nRequest Body : -\n\n{\n  \"ownerId\": \"payment-service-instance-42\",\n  \"lockType\": \"EXCLUSIVE\",\n  \"waitTimeoutMs\": 5000,\n  \"leaseDurationMs\": 30000,\n  \"reentrant\": false,\n  \"fair\": false\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Acquire Lock \n\nPOST /api/v1/locks/{lockKey}/acquire\n\nRequest Body : -\n\n{\n  \"ownerId\": \"payment-service-instance-42\",\n  \"lockType\": \"EXCLUSIVE\",\n  \"waitTimeoutMs\": 5000,\n  \"leaseDurationMs\": 30000,\n  \"reentrant\": false,\n  \"fair\": false\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LbnVJ0Y2FiyhDwSTv1eZz",
      "type": "text",
      "x": 1651.826805677205,
      "y": 515.2526841411291,
      "width": 529.4794921875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 1119505210,
      "version": 108,
      "versionNonce": 444713702,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788193795634,
      "link": null,
      "locked": false,
      "text": "Every successfull acquire gets a new monotonic\nincreasing function\nResponse Body :-\n\n{\n  \"lockKey\": \"order:123\",\n  \"lockId\": \"8f2c7c3e-5d91-4b2c-a9d2-123456789abc\",\n  \"ownerId\": \"payment-service-instance-42\",\n  \"fencingToken\": 1042,\n  \"acquiredAt\": \"2026-08-27T17:30:00Z\",\n  \"expiresAt\": \"2026-08-27T17:30:30Z\"\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every successfull acquire gets a new monotonic\nincreasing function\nResponse Body :-\n\n{\n  \"lockKey\": \"order:123\",\n  \"lockId\": \"8f2c7c3e-5d91-4b2c-a9d2-123456789abc\",\n  \"ownerId\": \"payment-service-instance-42\",\n  \"fencingToken\": 1042,\n  \"acquiredAt\": \"2026-08-27T17:30:00Z\",\n  \"expiresAt\": \"2026-08-27T17:30:30Z\"\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
