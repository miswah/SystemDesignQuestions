    },
    {
      "id": "CFrgtyC4PLNFy5lG5euSI",
      "type": "text",
      "x": 151.03483072916708,
      "y": 963.1556379530164,
      "width": 510.85968017578125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 939962155,
      "version": 136,
      "versionNonce": 1753638117,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779695918408,
      "link": null,
      "locked": false,
      "text": "1. Traffic Distribution \n    Should support different types of algorithm and \n    have the ability to change it on the fly ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Traffic Distribution \n    Should support different types of algorithm and \n    have the ability to change it on the fly ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-TWlFr4iN-csjZ7Ub1U6R",
      "type": "text",
      "x": 163.83481852213583,
      "y": 1094.7556135389539,
      "width": 590.819580078125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 1924623307,
      "version": 87,
      "versionNonce": 965701899,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779695974937,
      "link": null,
      "locked": false,
      "text": "2. Health Check\n    Should priodically check backend health using HTTP/TCP\n    Remove unhealthy instances and re-add when recovered",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Health Check\n    Should priodically check backend health using HTTP/TCP\n    Remove unhealthy instances and re-add when recovered",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "78IyVjJEUqKTb0sG5emM2",
      "type": "text",
      "x": 163.83481852213583,
      "y": 1245.9556257459851,
      "width": 488.83966064453125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 300665989,
      "version": 109,
      "versionNonce": 1696473451,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779696032233,
      "link": null,
      "locked": false,
      "text": "3. Resilience / Failover\n    Automatically reroute traffic if a backend fails\n    Support multiple LB instances",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Resilience / Failover\n    Automatically reroute traffic if a backend fails\n    Support multiple LB instances",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xChfvHiJwK7AKyozCYsnQ",
      "type": "text",
      "x": 130.23484293619833,
      "y": 1389.1556379530164,
      "width": 643.759521484375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 839844523,
      "version": 123,
      "versionNonce": 650768069,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779696079272,
      "link": null,
      "locked": false,
      "text": "    4. Observability Hook\n        Collect metrics: latency, error ratem traffic distribution etc",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    4. Observability Hook\n        Collect metrics: latency, error ratem traffic distribution etc",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hzzPw0K3epBkzfC-5P72q",
      "type": "text",
      "x": 919.0348917643233,
      "y": 969.1556379530164,
      "width": 508.21966552734375,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 1894664421,
      "version": 448,
      "versionNonce": 124922245,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779696241817,
      "link": null,
      "locked": false,
      "text": "1. Low Latency\n    Minimal added overhead per request\n\n2. High Availability\n    uptime needs to be > 99.99%\n    No single point of failure\n\n3. Scalability\n    Handle high RPS and concurrent connections\n    Horizontal scaling of LB nodes\n\n4. Reliability\n    Graceful handlign of backend failures\n    No request loss during failover\n\n5. Performance\n    Efficient connection handling (keep-alive, pooling)\n\n6. Security\n    TLS support basic DDoS protection",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low Latency\n    Minimal added overhead per request\n\n2. High Availability\n    uptime needs to be > 99.99%\n    No single point of failure\n\n3. Scalability\n    Handle high RPS and concurrent connections\n    Horizontal scaling of LB nodes\n\n4. Reliability\n    Graceful handlign of backend failures\n    No request loss during failover\n\n5. Performance\n    Efficient connection handling (keep-alive, pooling)\n\n6. Security\n    TLS support basic DDoS protection",
      "autoResize": true,
      "lineHeight": 1.25
    },
