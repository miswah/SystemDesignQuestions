      "seed": 643298827,
      "version": 303,
      "versionNonce": 1188668965,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779696455745,
      "link": null,
      "locked": false,
      "text": "Assumptions\n    * Read-heavy traffic [most requests are routing/forwarding]\n    * Millions ot billions of requests per day\n\nExample\n    * Incoming Requests\n        10k - 1M + RPS depending on scale\n\n    * Backend Connections\n        High Concurrent connections requiring efficient pooling",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumptions\n    * Read-heavy traffic [most requests are routing/forwarding]\n    * Millions ot billions of requests per day\n\nExample\n    * Incoming Requests\n        10k - 1M + RPS depending on scale\n\n    * Backend Connections\n        High Concurrent connections requiring efficient pooling",
      "autoResize": true,
      "lineHeight": 1.25
