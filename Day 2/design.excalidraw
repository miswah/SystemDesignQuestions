    {
      "id": "_ZCM7CLJMAS7epItgKPO_",
      "type": "text",
      "x": 164.63484160105418,
      "y": 1945.1553632948132,
      "width": 627.8195190429688,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
