    {
      "id": "ZZST0Ff-w_38LBzTcv2zi",
      "type": "text",
      "x": -1904.9124209339311,
      "y": -1440.4736167758415,
      "width": 560.99951171875,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 2121671437,
      "version": 610,
      "versionNonce": 641614317,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780413526117,
      "link": null,
      "locked": false,
      "text": "1. Request Throttling\n    Limit number of requests per client (user)\n     * 100 requests / min per user\n     * 1000 requests / min per API key\n\n2. Multiple Limit Dimensions\n     Per-user, per-IP, per-endpoint limits\n\n3. Rate Limiting Algorithm\n    Ability to switch/extend algorithm\n\n4. Dynamic Configuration\n    update rate limits without restart -> should timeout\n\n5. Response Handling\n    correct HTTP headers\n\n6. Burst Handling\n    Allow bursting : 100 req / min + burst of 20 requests ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Request Throttling\n    Limit number of requests per client (user)\n     * 100 requests / min per user\n     * 1000 requests / min per API key\n\n2. Multiple Limit Dimensions\n     Per-user, per-IP, per-endpoint limits\n\n3. Rate Limiting Algorithm\n    Ability to switch/extend algorithm\n\n4. Dynamic Configuration\n    update rate limits without restart -> should timeout\n\n5. Response Handling\n    correct HTTP headers\n\n6. Burst Handling\n    Allow bursting : 100 req / min + burst of 20 requests ",
      "autoResize": true,
      "lineHeight": 1.25
    },
