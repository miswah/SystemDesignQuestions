      "isDeleted": false,
      "boundElements": [],
      "updated": 1780413526117,
      "link": null,
      "locked": false,
      "text": "X-Ratelimit-Remaining: The remaining number of allowed requests within the window.\n\nX-Ratelimit-Limit: It indicates how many calls the client can make per time window.\n\nX-Ratelimit-Retry-After: The number of seconds to wait until you can make a request again \n                                without being throttled.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "X-Ratelimit-Remaining: The remaining number of allowed requests within the window.\n\nX-Ratelimit-Limit: It indicates how many calls the client can make per time window.\n\nX-Ratelimit-Retry-After: The number of seconds to wait until you can make a request again \n                                without being throttled.",
      "autoResize": true,
      "lineHeight": 1.25
    },
