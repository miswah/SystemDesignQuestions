      "boundElements": [],
      "updated": 1780413526117,
      "link": null,
      "locked": false,
      "text": "Assumptions\n\n* Write - heavy system\n    Every request updates counter\n\n* High Cardinality\n    Millions of unique keys (user/IP)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumptions\n\n* Write - heavy system\n    Every request updates counter\n\n* High Cardinality\n    Millions of unique keys (user/IP)",
      "autoResize": true,
      "lineHeight": 1.25
    },
