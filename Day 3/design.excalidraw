      "boundElements": [],
      "updated": 1780413526117,
      "link": null,
      "locked": false,
      "text": "domain: messaging\ndescriptors:\n  - key: message_type\n    value: marketing\n    rate_limit:\n      unit: day\n      requests_per_unit: 5",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "domain: messaging\ndescriptors:\n  - key: message_type\n    value: marketing\n    rate_limit:\n      unit: day\n      requests_per_unit: 5",
      "autoResize": true,
      "lineHeight": 1.25
    },
