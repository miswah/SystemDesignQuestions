    {
      "id": "m7xxNyec2ymkcLLPG-SYy",
      "type": "text",
      "x": -1222.4124209339311,
      "y": -1444.2236167758415,
      "width": 371.49969482421875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
