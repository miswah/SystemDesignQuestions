      "versionNonce": 261516749,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780413526117,
      "link": null,
      "locked": false,
      "text": "Storage Estimations\n    Data per key\n        * user ID -> 8 bytes\n        * Counter -> 4 bytes\n        * Timestamp ->  8  bytes\n        * Overhead -> ~20 bytes\n            Total = 40 bytes per key",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Storage Estimations\n    Data per key\n        * user ID -> 8 bytes\n        * Counter -> 4 bytes\n        * Timestamp ->  8  bytes\n        * Overhead -> ~20 bytes\n            Total = 40 bytes per key",
      "autoResize": true,
      "lineHeight": 1.25
    },
