      "seed": 331986061,
      "version": 241,
      "versionNonce": 1876847277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780413526117,
      "link": null,
      "locked": false,
      "text": "1. Low Lattency\n    * Overhead per requests < 5-10 ms\n    * Should not degrade API SLA\n\n2. High Availability\n    * Uptime >= 99.99%\n    * No single point of failure\n\n3. Scalability\n    * Support : 100k - 500K + RPS\n    * Handle 1M+ active users",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low Lattency\n    * Overhead per requests < 5-10 ms\n    * Should not degrade API SLA\n\n2. High Availability\n    * Uptime >= 99.99%\n    * No single point of failure\n\n3. Scalability\n    * Support : 100k - 500K + RPS\n    * Handle 1M+ active users",
      "autoResize": true,
      "lineHeight": 1.25
    },
