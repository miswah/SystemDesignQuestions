      "link": null,
      "locked": false,
      "text": "Indexing and Ingestion Pipeline",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Indexing and Ingestion Pipeline",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "trfQxTGKutcfz3x_0ZsD_",
      "type": "text",
      "x": 4149.889673880169,
      "y": 2062.408239334348,
      "width": 599.2395629882812,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": null,
      "seed": 354571749,
      "version": 376,
      "versionNonce": 148372901,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781021524052,
      "link": null,
      "locked": false,
      "text": "Pipeline is responsible for :\n\n* Collecting new and trending terms from multiple sources\n* CLeaning and normalizing the data\n* Scoring and ranking terms into the primary lookup structure\n* Indexing these terms into the primary lookup structure\n* Distributing updates across all autocomplete service nodes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pipeline is responsible for :\n\n* Collecting new and trending terms from multiple sources\n* CLeaning and normalizing the data\n* Scoring and ranking terms into the primary lookup structure\n* Indexing these terms into the primary lookup structure\n* Distributing updates across all autocomplete service nodes",
      "autoResize": true,
      "lineHeight": 1.25
    },
