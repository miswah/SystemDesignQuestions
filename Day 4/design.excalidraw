    {
      "id": "ERRsqeWoZMdy57jgILT4f",
      "type": "text",
      "x": 58.10000991821289,
      "y": -56.20000457763672,
      "width": 770.9395141601562,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
