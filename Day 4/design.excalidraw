      "seed": 1308415221,
      "version": 391,
      "versionNonce": 339341755,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780906011726,
      "link": null,
      "locked": false,
      "text": "1. Real-Time Suggestions\n    Provide suggestions as user types (debounced input)\n\n2. Prefix based Search\n    Return suggestions that match given prefix ie :- ap = [\"apple|, \"application\"]\n\n3. Ranking & Relevance\n    Rank Suggestions based on\n        * Popularity (global)\n        * Recency (trending Queries)\n        * Personalization (user history)\n\n4. Top K\n    Return top 5 suggestion",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Real-Time Suggestions\n    Provide suggestions as user types (debounced input)\n\n2. Prefix based Search\n    Return suggestions that match given prefix ie :- ap = [\"apple|, \"application\"]\n\n3. Ranking & Relevance\n    Rank Suggestions based on\n        * Popularity (global)\n        * Recency (trending Queries)\n        * Personalization (user history)\n\n4. Top K\n    Return top 5 suggestion",
      "autoResize": true,
      "lineHeight": 1.25
    },
