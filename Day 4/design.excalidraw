    {
      "type": "text",
      "version": 2286,
      "versionNonce": 8753509,
      "isDeleted": false,
      "id": "jycjuVdq9qjIBR2orA60S",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 57.60644531250034,
      "y": 1034.631221097231,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1177.4955109505104,
      "height": 815.1850167085325,
      "seed": 1821214226,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1781019703568,
      "link": null,
      "locked": false,
      "fontSize": 21.738267112227536,
      "fontFamily": 1,
      "text": "  - GET /v1/suggestions│ Fetch autocomplete suggestions │ Every keystroke (debounced) │\n  \nGET /v1/suggestions?prefix={prefix}&limit={limit}                                                            \n                                                                                                            \n  Example: GET /v1/suggestions?prefix=app&limit=5                                                          \n                                                                                                            \n  Response: {                                                                                               \n    \"suggestions\": [                                                                                         \n      { \"query\": \"apple\", \"score\": 1500000 },                                                                 \n      { \"query\": \"application\", \"score\": 1200000 },                                                           \n      { \"query\": \"april\", \"score\": 900000 },\n      { \"query\": \"apply\", \"score\": 700000 },\n      { \"query\": \"apps\", \"score\": 50000 },                                                                   \n    ],                                                                                                      \n    \"latency_ms\": 12                                                                                        \n  }                                                                                                         \n\n                                             \n  - /v1/searches    │ POST   │ Record completed search │ User submits search \n                                                                                                            \n  Request: {                                                                                               \n    \"query\": \"ap\",                                                                                            \n    \"user_id\": \"user1234\",                                                                                   \n    \"timestamp\": \"2026-02-16T17:30:00Z\"                                                                   \n  }                                                                                                         \n                                                                                                            \n  Response: {                                                                                               \n    \"status\": \"accepted\"                                                                                    \n  }                                              \n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  - GET /v1/suggestions│ Fetch autocomplete suggestions │ Every keystroke (debounced) │\n  \nGET /v1/suggestions?prefix={prefix}&limit={limit}                                                                                       \n                                                                                                                                          \n  Example: GET /v1/suggestions?prefix=app&limit=5                                                                               \n                                                                                                                                          \n  Response: {                                                                                                                             \n    \"suggestions\": [                                                                                                                      \n      { \"query\": \"apple\", \"score\": 1500000 },                                                                                 \n      { \"query\": \"application\", \"score\": 1200000 },                                                                                 \n      { \"query\": \"april\", \"score\": 900000 },\n      { \"query\": \"apply\", \"score\": 700000 },\n      { \"query\": \"apps\", \"score\": 50000 },                                                                                                                                                    \n    ],                                                                                                                                    \n    \"latency_ms\": 12                                                                                                                      \n  }                                                                                                                                       \n\n                                             \n  - /v1/searches    │ POST   │ Record completed search │ User submits search \n                                                                                                                                     \n  Request: {                                                                                                                              \n    \"query\": \"ap\",                                                                                                         \n    \"user_id\": \"user1234\",                                                                                                  \n    \"timestamp\": \"2026-02-16T17:30:00Z\"                                                                                                   \n  }                                                                                                                                       \n                                                                                                                                          \n  Response: {                                                                                                                             \n    \"status\": \"accepted\"                                                                                                                  \n  }                                              \n",
      "lineHeight": 1.25,
      "baseline": 795,
      "index": "aF",
      "autoResize": false
    },
