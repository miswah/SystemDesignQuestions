      "isDeleted": false,
      "boundElements": [],
      "updated": 1780905954121,
      "link": null,
      "locked": false,
      "text": "Low Latency\n    * latency < 100 ms\n    * Backend Latency < 20 - 30 ms\n\nHigh Availability\n    No single point of failure\n\nScalability\n    Handle 100k - 300k RPS\n    10M+ active users\n\nConsistency\n    Eventual consistency for updates is acceptable\n\nRead Optimization\n    Highly Optimized for read-heavy workloads",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Low Latency\n    * latency < 100 ms\n    * Backend Latency < 20 - 30 ms\n\nHigh Availability\n    No single point of failure\n\nScalability\n    Handle 100k - 300k RPS\n    10M+ active users\n\nConsistency\n    Eventual consistency for updates is acceptable\n\nRead Optimization\n    Highly Optimized for read-heavy workloads",
      "autoResize": true,
      "lineHeight": 1.25
    },
