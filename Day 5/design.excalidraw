    {
      "id": "x5CkWWoLKbZ-oNxe0loBW",
      "type": "text",
      "x": 263.5326783316473,
      "y": 731.8859461224266,
      "width": 1078.03955078125,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 101829116,
      "version": 455,
      "versionNonce": 1351914492,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781245593289,
      "link": null,
      "locked": false,
      "text": "Assumptions\n    * 10M pastes per month\n    * Average size per paste = 10kb\n    * Read:write = 10:1\n\nTraffic\n    * Writes : 40QPS (Peak ~80 QPS)\n    * Reads: 4000QPS (peak ~8000 QPS)\n\nStorage\n    * 40 writes /sec * 86400 * 30 = 103 million writes a month * 10 KB = 1,133,000,000 kb = 1.1TB per Month\n\n    * 4000 reads/sec * 86400 * 30 = 10.4 billion reads per month\n        Data Transfer 104 B * 10 kb = 104 TB per month\n\n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumptions\n    * 10M pastes per month\n    * Average size per paste = 10kb\n    * Read:write = 10:1\n\nTraffic\n    * Writes : 40QPS (Peak ~80 QPS)\n    * Reads: 4000QPS (peak ~8000 QPS)\n\nStorage\n    * 40 writes /sec * 86400 * 30 = 103 million writes a month * 10 KB = 1,133,000,000 kb = 1.1TB per Month\n\n    * 4000 reads/sec * 86400 * 30 = 10.4 billion reads per month\n        Data Transfer 104 B * 10 kb = 104 TB per month\n\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
