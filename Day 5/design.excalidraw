      "boundElements": null,
      "updated": 1781537171677,
      "link": null,
      "locked": false,
      "text": "\n/api/v1 : POST\n\n{\n    title: \"My Paste\",\n    visibility: \"public\",\n    content: \"10kb worth of text\",\n    expires: \"datetime,\n    allowed_users: [list of user emails]\n}\n\nThe user data for owner is pulled from \nuser session\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n/api/v1 : POST\n\n{\n    title: \"My Paste\",\n    visibility: \"public\",\n    content: \"10kb worth of text\",\n    expires: \"datetime,\n    allowed_users: [list of user emails]\n}\n\nThe user data for owner is pulled from \nuser session\n\n",
      "autoResize": true,
      "lineHeight": 1.25
