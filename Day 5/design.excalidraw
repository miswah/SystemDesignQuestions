    {
      "id": "z-uLrTYew5sPVIuhEFfX_",
      "type": "text",
      "x": 948.7232584272111,
      "y": 186.93351467072023,
      "width": 551.879638671875,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1853295868,
      "version": 371,
      "versionNonce": 1839412732,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781245108976,
      "link": null,
      "locked": false,
      "text": "1. Low Latency :\n    * Read < 100ms\n    * Write < 300ms\n\n2. Durability :  No Data Loss\n\n3. Consistency :\n    * Strong for writes/updates/delete\n    * Eventual for feeds/search\n\n4. Cost Efficient : Expire old data (default is 100 days)\n\n5. Security : Access Control",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low Latency :\n    * Read < 100ms\n    * Write < 300ms\n\n2. Durability :  No Data Loss\n\n3. Consistency :\n    * Strong for writes/updates/delete\n    * Eventual for feeds/search\n\n4. Cost Efficient : Expire old data (default is 100 days)\n\n5. Security : Access Control",
      "autoResize": true,
      "lineHeight": 1.25
    },
