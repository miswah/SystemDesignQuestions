      "seed": 1548904432,
      "version": 55,
      "versionNonce": 1988890384,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781537064330,
      "link": null,
      "locked": false
    },
    {
      "id": "Cgvhgh4Q2wBNGuOLaCYgG",
      "type": "text",
      "x": 2390.2502631004554,
      "y": 1639.9937891513684,
      "width": 908.7191772460938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 1788956144,
      "version": 219,
      "versionNonce": 407586800,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781537317500,
      "link": null,
      "locked": false,
      "text": "We will use a mix of lazy expiration and timed batch job to expire and remove the paste from\navailable content -> this will required as to do the same with cache as well\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We will use a mix of lazy expiration and timed batch job to expire and remove the paste from\navailable content -> this will required as to do the same with cache as well\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "T30btevUB_7C9LZomg884",
      "type": "text",
      "x": 2361.2661361163277,
      "y": 1736.708074865654,
      "width": 925.279052734375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 858771440,
      "version": 134,
      "versionNonce": 819910416,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781537604331,
      "link": null,
      "locked": false,
      "text": "Lazy Expiration\n expiration is enforced at read time. When a request arrives for a paste, the system checks \nwhether the expiration time has passed. If it has, the paste is treated as nonexistent and a \nseprate service is called to remove that from cache and db",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lazy Expiration\n expiration is enforced at read time. When a request arrives for a paste, the system checks \nwhether the expiration time has passed. If it has, the paste is treated as nonexistent and a \nseprate service is called to remove that from cache and db",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l3bswMgGb_rusCUXESRyb",
      "type": "text",
      "x": 2362.155025005217,
      "y": 1896.1525193100983,
      "width": 938.0191650390625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 1481494800,
      "version": 191,
      "versionNonce": 1026400528,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781537602296,
      "link": null,
      "locked": false,
      "text": "Batch Job\nThis job will run once a day when the load is at the lowest and remove all the entries that are \nexpired and has not yet been accessed",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Batch Job\nThis job will run once a day when the load is at the lowest and remove all the entries that are \nexpired and has not yet been accessed",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5G6MM7nhcgYY2RlMcnC2o",
