    {
      "id": "GFpxEzIeJUfTwGCEbF2MV",
      "type": "text",
      "x": 253.1999282836914,
      "y": 191.26673465304907,
      "width": 618.599609375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 975574268,
      "version": 371,
      "versionNonce": 1097772924,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781244792181,
      "link": null,
      "locked": false,
      "text": "1. Create Paste\n    Content, title, expiry etc, this should generate a short URL\n\n2. Get Paste\n    * Fetch via short link\n    * Respect visibility & expiry\n    * Visibility for specifiy users only (optional)\n\n3. Delete Paste\n    Should only be deleted by the owner\n\n4. Additional Features\n    * Edit paste by owner\n    * Rate Limiting",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Create Paste\n    Content, title, expiry etc, this should generate a short URL\n\n2. Get Paste\n    * Fetch via short link\n    * Respect visibility & expiry\n    * Visibility for specifiy users only (optional)\n\n3. Delete Paste\n    Should only be deleted by the owner\n\n4. Additional Features\n    * Edit paste by owner\n    * Rate Limiting",
      "autoResize": true,
      "lineHeight": 1.25
    },
