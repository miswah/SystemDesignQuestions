      "boundElements": null,
      "updated": 1781536934372,
      "link": null,
      "locked": false,
      "text": "To generate unqiune URL we can use XXH3 hash using client ip and timestamp \nand we encode it with base62 to make it url safe",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To generate unqiune URL we can use XXH3 hash using client ip and timestamp \nand we encode it with base62 to make it url safe",
      "autoResize": true,
      "lineHeight": 1.25
    },
