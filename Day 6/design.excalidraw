    {
      "id": "7qyO2_0SSVi7gVv7iDDDc",
      "type": "text",
      "x": 1044.2817460317458,
      "y": 371.3095238095236,
      "width": 464.09954833984375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1192399697,
      "version": 288,
      "versionNonce": 1736951153,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781802659094,
      "link": null,
      "locked": false,
      "text": "1. Like action latency : <100-200 ms\n2. tens of thousands of writes/sec\n3. System should degrade gracefullly\n4. Strong Consistency -> no delay in like counts\n5. User should immediately see their own like\n6. read-heavy system -> read >> writes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Like action latency : <100-200 ms\n2. tens of thousands of writes/sec\n3. System should degrade gracefullly\n4. Strong Consistency -> no delay in like counts\n5. User should immediately see their own like\n6. read-heavy system -> read >> writes",
      "autoResize": true,
      "lineHeight": 1.25
    },
