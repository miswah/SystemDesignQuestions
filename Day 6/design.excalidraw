    {
      "id": "eCLpdT2Sh9Rd1xruvmRfd",
      "type": "text",
      "x": 298.34920634920564,
      "y": 822.2420634920634,
      "width": 329.47967529296875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1471018609,
      "version": 259,
      "versionNonce": 892710449,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781802826727,
      "link": null,
      "locked": false,
      "text": "1. Traffic Estimates\n    * Total likes/day : ~5 billion\n    * Likes/sec: `60,000 likes/sec\n    * 50k-70k write QPS\n    * Read:Write = 100:1\n\n2. Data Storage\n    * userId - 8 bytes\n    * postId - 8 bytes\n    * timestamp - 8 bytes\n    total 24-32 bytes per like",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Traffic Estimates\n    * Total likes/day : ~5 billion\n    * Likes/sec: `60,000 likes/sec\n    * 50k-70k write QPS\n    * Read:Write = 100:1\n\n2. Data Storage\n    * userId - 8 bytes\n    * postId - 8 bytes\n    * timestamp - 8 bytes\n    total 24-32 bytes per like",
      "autoResize": true,
      "lineHeight": 1.25
    },
