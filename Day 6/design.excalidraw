    {
      "id": "NN9BQIKDjyfN7aDvhFHaa",
      "type": "text",
      "x": 304,
      "y": 361,
      "width": 534.0994873046875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 538822513,
      "version": 460,
      "versionNonce": 1901056607,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781802479563,
      "link": null,
      "locked": false,
      "text": "1. Like a post `likePost(userId, postId)`\n2. Unlike a post `unlikePost(userId, postId)`\n3. if user has liked the post `isLiked(userId, postId)`\n4. Get total like count `likesCount(postId)`\n\n5. Multiple clicks should not create duplicate likes\n\nOptional Functional Features\n\n1. show list of users who liked the post\n2. Notify post owner when someone likes their post\n3. Use likes for ranking / engagement signals ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Like a post `likePost(userId, postId)`\n2. Unlike a post `unlikePost(userId, postId)`\n3. if user has liked the post `isLiked(userId, postId)`\n4. Get total like count `likesCount(postId)`\n\n5. Multiple clicks should not create duplicate likes\n\nOptional Functional Features\n\n1. show list of users who liked the post\n2. Notify post owner when someone likes their post\n3. Use likes for ranking / engagement signals ",
      "autoResize": true,
      "lineHeight": 1.25
    },
