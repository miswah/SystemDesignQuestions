    {
      "id": "uVPnsfiGsCc19O6jnnm9S",
      "type": "text",
      "x": 1109.8849206349182,
      "y": 809.8253968253964,
      "width": 415.49957275390625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 373263665,
      "version": 242,
      "versionNonce": 599787313,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781803598392,
      "link": null,
      "locked": false,
      "text": "1. likePost(postId)\n   GET : /api/v1/posts/{postId}/like\n   \n2. unlikePost(postId)\n    DELETE : /api/v1/posts/{postId}/like",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. likePost(postId)\n   GET : /api/v1/posts/{postId}/like\n   \n2. unlikePost(postId)\n    DELETE : /api/v1/posts/{postId}/like",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bzBzuOcrNOs28_FGGgNvf",
      "type": "text",
      "x": 1105.3015873015847,
      "y": 971.4920634920629,
      "width": 452.0595703125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1653928849,
      "version": 232,
      "versionNonce": 1903819025,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781803598392,
      "link": null,
      "locked": false,
      "text": "3. isLiked(postId)\n    POST : /api/v1/posts/{postId}/likes\n\n4. likesCount(postId)\n    GET : /api/v1/posts/{postId}/likes/count",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. isLiked(postId)\n    POST : /api/v1/posts/{postId}/likes\n\n4. likesCount(postId)\n    GET : /api/v1/posts/{postId}/likes/count",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1Gqa_BAjZ6pbf10oE9mz6",
      "type": "text",
      "x": 1126.4126984126965,
      "y": 1164.8452380952374,
      "width": 541.8394775390625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 499907455,
      "version": 144,
      "versionNonce": 987410161,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781803598392,
      "link": null,
      "locked": false,
      "text": "All REST API are idempotent calling the same api again\n will not result in double results",
      "fontSize": 20,
      "fontFamily": 5,
