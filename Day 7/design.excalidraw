    },
    {
      "id": "kpCkGk5ckSNv9_1Rp4ltN",
      "type": "text",
      "x": 170.72222222222223,
      "y": 218.38888888888889,
      "width": 554.699462890625,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 185391504,
      "version": 750,
      "versionNonce": 807074192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782493123392,
      "link": null,
      "locked": false,
      "text": "1. Multi-channel delivery\n    * Push Notifications, Email, SMS, In-app notifications\n2. Event-driven notification\n    * Tigger on user actions (Payments, Messages)\n    * Trigger on system event (fraud alerts, downtime)\n3. Priority Handling\n    * Critical (OTP, Security alerts)\n    * Non-Critical (Marketing, promotions)\n4. User Preferences\n    * Opt-in / Opt-out\n    * Channel preferences\n    * Quiet hours / DND\n5. Message Templating\n    * Dynamic Templates (email/SMS)\n    * Localization support\n6. Scheduling support\n    * Immediate delivery\n    * Delayed / Scheduled messages\n7. Deduplication\n    * Prevent duplicate notifications\n8. Broadcast Campaigns\n    * send to millions of users",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Multi-channel delivery\n    * Push Notifications, Email, SMS, In-app notifications\n2. Event-driven notification\n    * Tigger on user actions (Payments, Messages)\n    * Trigger on system event (fraud alerts, downtime)\n3. Priority Handling\n    * Critical (OTP, Security alerts)\n    * Non-Critical (Marketing, promotions)\n4. User Preferences\n    * Opt-in / Opt-out\n    * Channel preferences\n    * Quiet hours / DND\n5. Message Templating\n    * Dynamic Templates (email/SMS)\n    * Localization support\n6. Scheduling support\n    * Immediate delivery\n    * Delayed / Scheduled messages\n7. Deduplication\n    * Prevent duplicate notifications\n8. Broadcast Campaigns\n    * send to millions of users",
      "autoResize": true,
      "lineHeight": 1.25
    },
