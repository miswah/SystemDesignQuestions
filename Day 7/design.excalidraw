      "updated": 1782494293707,
      "link": null,
      "locked": false,
      "text": "{\n  \"requestId\": \"abc123\",\n  \"timestamp\": \"2024-09-17T14:00:00Z\",\n  \"notificationType\": \"transactional\",\n  \"channels\": [\n    \"email\",\n    \"sms\",\n    \"push\"\n  ],\n  \"recipient\": {\n    \"userId\": \"user789\",\n    \"email\": \"user@example.com\"\n  },\n  \"email\": {\n    \"subject\": \"Order Confirmation\",\n    \"template\": \"Order_Confirmation\",\n    \"context\": {\n    \"KEY\" : \"VALUE\"    \n    },\n    \"smsText\": \"Thank you for your order! Order #123456 confirmed.\",\n    \"pushNotification\": {\n      \"title\": \"Order Confirmed\",\n      \"template\": \"Order_Confirmation\",\n      \"icon\": \"https://example.com/icon.png\",\n      \"action\": {\n        \"type\": \"viewOrder\",\n        \"url\": \"https://example.com/order/123456\"\n      },\n       \"context\": {\n            \"KEY\" : \"VALUE\"    \n        },\n    }\n  },\n  \"schedule\": {\n    \"sendAt\": \"2024-09-17T15:00:00Z\"\n  },\n  \"metadata\": {\n    \"priority\": \"high\",\n    \"retries\": 3\n  }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n  \"requestId\": \"abc123\",\n  \"timestamp\": \"2024-09-17T14:00:00Z\",\n  \"notificationType\": \"transactional\",\n  \"channels\": [\n    \"email\",\n    \"sms\",\n    \"push\"\n  ],\n  \"recipient\": {\n    \"userId\": \"user789\",\n    \"email\": \"user@example.com\"\n  },\n  \"email\": {\n    \"subject\": \"Order Confirmation\",\n    \"template\": \"Order_Confirmation\",\n    \"context\": {\n    \"KEY\" : \"VALUE\"    \n    },\n    \"smsText\": \"Thank you for your order! Order #123456 confirmed.\",\n    \"pushNotification\": {\n      \"title\": \"Order Confirmed\",\n      \"template\": \"Order_Confirmation\",\n      \"icon\": \"https://example.com/icon.png\",\n      \"action\": {\n        \"type\": \"viewOrder\",\n        \"url\": \"https://example.com/order/123456\"\n      },\n       \"context\": {\n            \"KEY\" : \"VALUE\"    \n        },\n    }\n  },\n  \"schedule\": {\n    \"sendAt\": \"2024-09-17T15:00:00Z\"\n  },\n  \"metadata\": {\n    \"priority\": \"high\",\n    \"retries\": 3\n  }\n}",
