    {
      "id": "6V10xp6tILJ7-pu8DvRB6",
      "type": "text",
      "x": 161.04945285376914,
      "y": 929.409677376786,
      "width": 655.179443359375,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 737356656,
      "version": 502,
      "versionNonce": 859675504,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782493748142,
      "link": null,
      "locked": false,
      "text": "1. Assumptions\n    * total users : 100 Million\n    * Daily active users : 20 Million\n    * Notifications per user per day : 10 \n\n2. Traffic Calculation\n    * total notification per day = 20M * 10 = 200M\n    * Average QPS = 200M / (24 / 3600) = 2300 requests per sec\n\nPeak QPS = 23000 notifications/sec\n\n\n3. Storage Estimation\n    * Notification Payload\n        Average size : 1Kb\n\n    * Storage / day = 200M * 1 KB = 200GB/day\n    * Monthly = 6TB\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Assumptions\n    * total users : 100 Million\n    * Daily active users : 20 Million\n    * Notifications per user per day : 10 \n\n2. Traffic Calculation\n    * total notification per day = 20M * 10 = 200M\n    * Average QPS = 200M / (24 / 3600) = 2300 requests per sec\n\nPeak QPS = 23000 notifications/sec\n\n\n3. Storage Estimation\n    * Notification Payload\n        Average size : 1Kb\n\n    * Storage / day = 200M * 1 KB = 200GB/day\n    * Monthly = 6TB\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
