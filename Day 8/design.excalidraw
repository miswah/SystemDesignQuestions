    {
      "id": "1xDSvn5tZOAKw3IDgMq30",
      "type": "text",
      "x": 3317.474177395112,
      "y": 875.8525464232013,
      "width": 543.3595581054688,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 129691636,
      "version": 140,
      "versionNonce": 478846668,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784566975003,
      "link": null,
      "locked": false,
      "text": "| Geohash Length | Approx. Grid Size (Width × Height) |\n| -------------- | ---------------------------------- |\n| 1              | 5,000 km × 5,000 km           |\n| 2              | 1,250 km × 625 km             |\n| 3              | 156 km × 156 km                |\n| 4              | 39.1 km × 19.5 km               |\n| 5              | 4.89 km × 4.89 km              |\n| 6              | 1.22 km × 0.61 km               |\n| 7              | 153 m × 153 m                    |\n| 8              | 38.2 m × 19.1 m                  |\n| 9              | 4.77 m × 4.77 m                  |\n| 10             | 1.19 m × 0.596 m                |\n| 11             | 149 mm × 149 mm                 |\n| 12             | 37.2 mm × 18.6 mm              |\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Geohash Length | Approx. Grid Size (Width × Height) |\n| -------------- | ---------------------------------- |\n| 1              | 5,000 km × 5,000 km           |\n| 2              | 1,250 km × 625 km             |\n| 3              | 156 km × 156 km                |\n| 4              | 39.1 km × 19.5 km               |\n| 5              | 4.89 km × 4.89 km              |\n| 6              | 1.22 km × 0.61 km               |\n| 7              | 153 m × 153 m                    |\n| 8              | 38.2 m × 19.1 m                  |\n| 9              | 4.77 m × 4.77 m                  |\n| 10             | 1.19 m × 0.596 m                |\n| 11             | 149 mm × 149 mm                 |\n| 12             | 37.2 mm × 18.6 mm              |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rq7bw_LB-VVOBXMXmJuWL",
      "type": "text",
      "x": 3893.7555224469343,
      "y": 849.8539031683109,
      "width": 635.8194580078125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
