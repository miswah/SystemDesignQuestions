      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 2004196044,
      "version": 145,
      "versionNonce": 1508173132,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784566975003,
      "link": null,
      "locked": false,
      "text": "We are only intreseted in geohashes with length between 4 and 6\notherwise the grid size is too small or too big",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We are only intreseted in geohashes with length between 4 and 6\notherwise the grid size is too small or too big",
      "autoResize": true,
      "lineHeight": 1.25
    },
