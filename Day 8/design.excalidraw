      "seed": 1381886883,
      "version": 222,
      "versionNonce": 479388867,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784526122553,
      "link": null,
      "locked": false,
      "text": "Assumptions : 100M POIs, 100M DAU, Average 5 searches / day\n\nRead QPS : 100M * 5 / 86400 = 5,800 QPS average\n\nStorage : 500 bytes per POI\n    100M * 500 = 50GB\nwith indexing overhead : 100-150 GB",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumptions : 100M POIs, 100M DAU, Average 5 searches / day\n\nRead QPS : 100M * 5 / 86400 = 5,800 QPS average\n\nStorage : 500 bytes per POI\n    100M * 500 = 50GB\nwith indexing overhead : 100-150 GB",
      "autoResize": true,
      "lineHeight": 1.25
    },
