    {
      "id": "r99S1eqlT7nWxDLqV3Epp",
      "type": "text",
      "x": 3307.397338454133,
      "y": 1273.618588410243,
      "width": 1219.5987548828125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1O",
      "roundness": null,
      "seed": 172655220,
      "version": 239,
      "versionNonce": 1005172596,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784567063140,
      "link": null,
      "locked": false,
      "text": "4. Quadtree -> a data structure that is commonly used to partition a two dimensional space by recursively subdivding it into\n    four quadrant until the number of businesses in the grid is not more than 100",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Quadtree -> a data structure that is commonly used to partition a two dimensional space by recursively subdivding it into\n    four quadrant until the number of businesses in the grid is not more than 100",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ioByE3r4jYn78GRPrGnPy",
      "type": "text",
      "x": 3309.54831090878,
      "y": 1361.8084590507597,
      "width": 1122.5791015625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1P",
      "roundness": null,
      "seed": 642869876,
      "version": 24,
      "versionNonce": 1043252044,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784567130056,
      "link": null,
      "locked": false,
      "text": "5. Google S2 -> Each cell is identified by a unique S2 Cell ID, and every subdivision increases the S2 level (0–30). \n    Lower levels represent large geographic regions, while higher levels provide progressively finer spatial resolution, \n    down to centimeter-scale precision.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Google S2 -> Each cell is identified by a unique S2 Cell ID, and every subdivision increases the S2 level (0–30). \n    Lower levels represent large geographic regions, while higher levels provide progressively finer spatial resolution, \n    down to centimeter-scale precision.",
      "autoResize": true,
      "lineHeight": 1.25
    },
