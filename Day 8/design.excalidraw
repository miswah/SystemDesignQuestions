    {
      "id": "rPIui70ppM490BOx67tyU",
      "type": "text",
      "x": 349.39995744493274,
      "y": 930.0889290703668,
      "width": 491.33966064453125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 280827139,
      "version": 407,
      "versionNonce": 1922254659,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784525972212,
      "link": null,
      "locked": false,
      "text": "1. Supports upto :\n    * 100M+ POIs globally\n    * Milliions of searches per second\n    * Worldwide geographic coverage\n\n2. Availability\n    * 99.99% availability\n    * No single point of failure\n    * Multi-region deployment\n\n3. Accuracy Results must :\n    * Stay within requested radius\n    * Return exact distance calculations\n    * Avoid Missing Nearby POIs at cell boundaries",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Supports upto :\n    * 100M+ POIs globally\n    * Milliions of searches per second\n    * Worldwide geographic coverage\n\n2. Availability\n    * 99.99% availability\n    * No single point of failure\n    * Multi-region deployment\n\n3. Accuracy Results must :\n    * Stay within requested radius\n    * Return exact distance calculations\n    * Avoid Missing Nearby POIs at cell boundaries",
      "autoResize": true,
      "lineHeight": 1.25
    },
