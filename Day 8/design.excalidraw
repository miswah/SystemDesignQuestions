    {
      "id": "hikrjpl5zVtuvTsw_Z0Hp",
      "type": "text",
      "x": 346.39986334906683,
      "y": 1398.4222878350151,
      "width": 627.4395751953125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
