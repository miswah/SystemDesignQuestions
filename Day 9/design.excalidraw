      "seed": 46752606,
      "version": 151,
      "versionNonce": 974474014,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784740883934,
      "link": null,
      "locked": false,
      "text": "Location Storage\n\nUser Id      = 8 bytes\nLatitude     = 8 bytes\nLongitude    = 8 bytes\nTimestamp    = 8 bytes\nMetadata     = 30 bytes\n\nTotal ≈ 64 bytes\n\n10m users * 64 bytes = 640MB\nIncluding indexing overhead = 2Gb",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Location Storage\n\nUser Id      = 8 bytes\nLatitude     = 8 bytes\nLongitude    = 8 bytes\nTimestamp    = 8 bytes\nMetadata     = 30 bytes\n\nTotal ≈ 64 bytes\n\n10m users * 64 bytes = 640MB\nIncluding indexing overhead = 2Gb",
      "autoResize": true,
      "lineHeight": 1.25
    },
