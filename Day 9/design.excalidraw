    {
      "id": "-UrW5Ado9VgMyf5IAyipo",
      "type": "text",
      "x": -44.63329395477473,
      "y": 883.3825709160287,
      "width": 638.3994140625,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1980019102,
      "version": 371,
      "versionNonce": 1924192926,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784740883934,
      "link": null,
      "locked": false,
      "text": "DAU = 10M, Concurrent Active Users 1M, Location Update 30sec\n\nAevarege friends per user 200\nNearby search radius 5km\nLocation Payload 100bytes\n\n* Write Traffic Calcuation\n    1m concurrent users / 30 = 33,33 updates per second\n\n* Read Traffic Calcuation\n    Assume each active user opens nearby screen every 2 minutes.\n    1m concurrent users / 120 sec = 833 reads / sec",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DAU = 10M, Concurrent Active Users 1M, Location Update 30sec\n\nAevarege friends per user 200\nNearby search radius 5km\nLocation Payload 100bytes\n\n* Write Traffic Calcuation\n    1m concurrent users / 30 = 33,33 updates per second\n\n* Read Traffic Calcuation\n    Assume each active user opens nearby screen every 2 minutes.\n    1m concurrent users / 120 sec = 833 reads / sec",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dZ8V9OR2dwbPznGSqP93l",
