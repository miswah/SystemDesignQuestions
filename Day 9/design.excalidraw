    {
      "id": "nsy6vSLDgOuGd_giX2DP0",
      "type": "text",
      "x": 682.6022948241953,
      "y": 1058.1021365245692,
      "width": 1363.379150390625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 1125163041,
      "version": 631,
      "versionNonce": 1521812321,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785776385248,
      "link": null,
      "locked": false,
      "text": "Redis Pub/Sub is a lightweight message bus channels are very cheap to create, one modern redis server can handle millions of them\n\n\nLocation updated received via websocket is published to user own channel a dedicated websocket server for each friend subscribe to that \nChannel get the location and compute the distance if it's within the radius send to client\n\nThis whole process happens for active friends only as the websocket/pub/sub channel only exists for them",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis Pub/Sub is a lightweight message bus channels are very cheap to create, one modern redis server can handle millions of them\n\n\nLocation updated received via websocket is published to user own channel a dedicated websocket server for each friend subscribe to that \nChannel get the location and compute the distance if it's within the radius send to client\n\nThis whole process happens for active friends only as the websocket/pub/sub channel only exists for them",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mhEK1pXy0RQvi-25uZuPn",
      "type": "text",
      "x": 725.2690225260181,
      "y": 1298.1021365245688,
      "width": 171.07989501953125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ar",
      "roundness": null,
      "seed": 1152343919,
      "version": 28,
      "versionNonce": 159663425,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785776569947,
      "link": null,
      "locked": false,
      "text": "Talk about erlang",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Talk about erlang",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DEcNHexx9mpOp9cDhElTc",
      "type": "text",
      "x": 838.6022541340911,
      "y": 1336.1020144542567,
      "width": 1105.2393798828125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 623858415,
      "version": 21,
      "versionNonce": 1339681647,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785776573383,
      "link": null,
      "locked": false,
      "text": "A minimal Erlang process takes about 300 bytes, and we can have millions of these processes on a single modern \nserver. If there is no work to do in an Erlang process, it just sits there without using any CPU cycles at all. \nIn other words, it is extremely cheap to model each of the 10 million active users in our design as an \nindividual Erlang process.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A minimal Erlang process takes about 300 bytes, and we can have millions of these processes on a single modern \nserver. If there is no work to do in an Erlang process, it just sits there without using any CPU cycles at all. \nIn other words, it is extremely cheap to model each of the 10 million active users in our design as an \nindividual Erlang process.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
