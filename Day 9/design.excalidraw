    {
      "id": "DU4cWr6zrOznniWyyyoOJ",
      "type": "text",
      "x": -42.558079974023286,
      "y": 1236.959282861179,
      "width": 332.99969482421875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
